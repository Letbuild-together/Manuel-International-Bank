version: "3.9"

services:
  postgres:
    image: postgres:16-alpine
    container_name: manuel-bank-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: manuel_bank
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  api:
    build:
      context: ./apps/api
      dockerfile: Dockerfile
    container_name: manuel-bank-api
    depends_on:
      - postgres
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: 3001
      DATABASE_URL: postgresql://postgres:postgres@postgres:5432/manuel_bank?schema=public
      JWT_SECRET: change-me-in-production
      JWT_EXPIRES_IN: 3600
    ports:
      - "3001:3001"

  web:
    build:
      context: ./apps/web
      dockerfile: Dockerfile
    container_name: manuel-bank-web
    depends_on:
      - api
    restart: unless-stopped
    environment:
      NODE_ENV: production
      NEXT_PUBLIC_API_URL: http://localhost:3001/api
    ports:
      - "3000:3000"

volumes:
  postgres_data:
